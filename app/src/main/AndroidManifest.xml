<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- อ่านรายชื่อ deck จาก AnkiDroid (API ทางการของ AnkiDroid) -->
    <uses-permission android:name="com.ichi2.anki.permission.READ_WRITE_DATABASE" />

    <!-- (ไม่บังคับ) ถ้าอนุญาตผ่าน adb ครั้งเดียว โหมดธนาคารจะเปิด/ปิดผู้ช่วยได้ในแตะเดียว -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- ให้มองเห็นและเปิด AnkiDroid ได้ (Android 11+) -->
    <queries>
        <package android:name="com.ichi2.anki" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ผู้ช่วยกดแทนใน AnkiDroid (ผู้ใช้เปิดเองใน ตั้งค่า > การช่วยเหลือพิเศษ) -->
        <service
            android:name=".RoundsService"
            android:exported="false"
            android:label="@string/service_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/rounds_service" />
        </service>

        <!-- ปุ่มในแถบตั้งค่าด่วน (ดึงแถบแจ้งเตือนลง) -->
        <service
            android:name=".RoundsTile"
            android:exported="true"
            android:icon="@drawable/ic_tile_plus"
            android:label="@string/tile_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- ปุ่ม "โหมดธนาคาร" ในแผงควบคุม -->
        <service
            android:name=".BankTile"
            android:exported="true"
            android:icon="@drawable/ic_tile_bank"
            android:label="@string/bank_tile_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>
</manifest>
