<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- รู้ว่าแอปไหนเปิดอยู่ เพื่อแสดงปุ่มลอยเฉพาะใน TikTok / IG / Facebook (ผู้ใช้เปิดเองในตั้งค่า) -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="FrameGrab"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ViewerActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity="com.v2f.framegrab.viewer"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />

        <activity
            android:name=".CropActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity="com.v2f.framegrab.crop"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar" />

        <activity
            android:name=".TextPickActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity="com.v2f.framegrab.text"
            android:theme="@android:style/Theme.DeviceDefault.Dialog.NoActionBar" />

        <provider
            android:name=".FrameProvider"
            android:authorities="com.v2f.framegrab.frames"
            android:exported="false"
            android:grantUriPermissions="true" />

        <service
            android:name=".HoldService"
            android:exported="true"
            android:label="FrameGrab: กดค้างซ่อนชื่อสตอรี่"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/hold_service" />
        </service>

        <service
            android:name=".QsTile"
            android:exported="true"
            android:icon="@android:drawable/ic_menu_camera"
            android:label="FrameGrab"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".CaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />
    </application>
</manifest>
